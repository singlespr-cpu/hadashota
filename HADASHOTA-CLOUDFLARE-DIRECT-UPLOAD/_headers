# V158 — static assets bypass the Worker and can be cached aggressively because
# JS/CSS URLs are versioned on every release. Worker-generated HTML/API responses
# keep their own explicit caching/security headers.
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800

/site.webmanifest
  Cache-Control: public, max-age=86400
