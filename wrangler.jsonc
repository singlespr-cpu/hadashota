{
  "name": "hadashota",
  "main": "./HADASHOTA-CLOUDFLARE-DIRECT-UPLOAD/_worker.js",
  "compatibility_date": "2026-07-24",
  "assets": {
    "directory": "./HADASHOTA-CLOUDFLARE-DIRECT-UPLOAD",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/sw.js",
      "/robots.txt",
      "/sitemap.xml",
      "/manage-kp-7538"
    ]
  }
}
