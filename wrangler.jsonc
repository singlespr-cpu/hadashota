{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hadashota",
  "main": "HADASHOTA-CLOUDFLARE-DIRECT-UPLOAD/_worker.js",
  "compatibility_date": "2026-08-12",
  "assets": {
    "directory": "./HADASHOTA-CLOUDFLARE-DIRECT-UPLOAD",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/",
      "/index.html",
      "/escalation",
      "/escalation.html",
      "/מדד-ההסלמה",
      "/%D7%9E%D7%93%D7%93-%D7%94%D7%94%D7%A1%D7%9C%D7%9E%D7%94",
      "/about",
      "/about.html",
      "/how-it-works",
      "/how-it-works.html",
      "/contact",
      "/contact.html",
      "/privacy",
      "/privacy.html",
      "/copyright",
      "/copyright.html",
      "/manage-kp-7538",
      "/robots.txt",
      "/sitemap.xml",
      "/app.js",
      "/styles.css",
      "/escalation.js",
      "/escalation.css",
      "/contact.js",
      "/site-analytics.js",
      "/info.css",
      "/site.webmanifest",
      "/sw.js"
    ],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PUSH_HUB",
        "class_name": "PushHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v123-true-web-push-1",
      "new_sqlite_classes": [
        "PushHub"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
